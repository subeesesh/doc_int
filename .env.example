# ===================================================
# Enterprise Document Intelligence - Configuration
# ===================================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=enterprise_intelligence
POSTGRES_USER=enterprise_user
POSTGRES_PASSWORD=enterprise_password

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6335
QDRANT_COLLECTION=document_chunks

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=document_chunks
ELASTICSEARCH_PASSWORD=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=enterprise-documents
MINIO_SECURE=false

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM
LLM_PROVIDER=local
LLM_MODEL=qwen2.5:1.5b
OLLAMA_URL=http://localhost:11434

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Auth
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# File Upload
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt,.xlsx,.xls,.pptx,.png,.jpg,.jpeg,.tiff
